@startuml
!include _style.iuml
hide circle
skinparam nodesep 35
skinparam ranksep 60
title Class Diagram (1/3) — Movie catalog: Adapter, Builder

interface CurrentUserProvider <<interface>> {
  +currentUserId() : Optional<Long>
  +requireUserId() : Long
}
class SecurityCurrentUserProvider {
}
class MovieController {
  +search(MovieSearchCriteria) : PageResponse
  +detail(Long id) : MovieDetailResponse
  +recommended(int limit) : List
}
interface MovieQueryService <<interface>> {
  +search(MovieSearchCriteria) : PageResponse
  +getDetail(Long movieId) : MovieDetailResponse
}
interface MovieDiscoveryService <<interface>> {
  +recommendedFor(Optional<Long> userId, int limit) : List
}
class MovieQueryServiceImpl {
}
interface MovieSyncService <<interface>> {
  +syncCatalog() : int
  +syncGenres() : int
  +importSearchResults(String query) : int
  +refreshDetails(Movie movie)
}
class MovieSyncServiceImpl {
}
interface MovieRepository <<interface>> {
  +findByTmdbId(Long) : Optional<Movie>
}
interface MovieCatalogSource <<interface>> {
  +isAvailable() : boolean
  +fetchGenres() : Map<Integer, String>
  +fetchList(MovieListType, int page) : List<ExternalMovie>
  +search(String query) : List<ExternalMovie>
  +fetchDetails(long externalId) : Optional<ExternalMovie>
}
class MovieSpecificationBuilder <<Builder>> {
  {static} +create() : MovieSpecificationBuilder
  +text(String) : MovieSpecificationBuilder
  +genre(Integer) : MovieSpecificationBuilder
  +minRating(Double) : MovieSpecificationBuilder
  +build() : Specification<Movie>
}
interface GenreRepository <<interface>> {
}
class TmdbMovieCatalogAdapter <<Adapter>> {
}
class TmdbClient {
  +list(String path, int page) : TmdbPageDto
  +search(String query) : TmdbPageDto
  +details(long tmdbId) : TmdbMovieDetailsDto
  +genres() : TmdbGenreListDto
}
class MovieSyncJob {
  +run()
}

CurrentUserProvider <|.. SecurityCurrentUserProvider
MovieController --> MovieQueryService
MovieController --> MovieDiscoveryService
MovieController --> CurrentUserProvider
MovieQueryService <|.. MovieQueryServiceImpl
MovieSyncService <|.. MovieSyncServiceImpl
MovieQueryServiceImpl --> MovieRepository
MovieQueryServiceImpl --> MovieSyncService
MovieQueryServiceImpl --> MovieCatalogSource
MovieQueryServiceImpl ..> MovieSpecificationBuilder : uses
MovieSyncServiceImpl --> MovieCatalogSource
MovieSyncServiceImpl --> MovieRepository
MovieSyncServiceImpl --> GenreRepository
MovieCatalogSource <|.. TmdbMovieCatalogAdapter
TmdbMovieCatalogAdapter --> TmdbClient
MovieSyncJob --> MovieSyncService
note bottom of TmdbMovieCatalogAdapter : MovieCatalogSource ← TmdbClient
@enduml
