@startuml
!include _style.iuml
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 70
title Cinema Log & Release Radar — Use Case Diagram

actor "Visitor" as Visitor
actor "Member" as Member

rectangle "Cinema Log & Release Radar" {
  ' Account
  usecase "UC01 Register account" as UC01
  usecase "UC02 Log in" as UC02
  usecase "UC03 Log out" as UC03
  usecase "UC04 Pick favorite genres" as UC04
  usecase "UC21 Edit profile & view stats" as UC21
  ' Catalog
  usecase "UC05 Browse discovery shelves\n(now showing / upcoming /\ntop rated / recommended)" as UC05
  usecase "UC06 Search & filter catalog" as UC06
  usecase "UC07 Import search results\nfrom TMDB" as UC07
  usecase "UC08 View movie details" as UC08
  usecase "UC09 Refresh movie details\nfrom TMDB" as UC09
  usecase "UC10 Read movie reviews" as UC10
  ' Library and diary
  usecase "UC11 Like / unlike movie" as UC11
  usecase "UC12 Add / remove watchlist" as UC12
  usecase "UC13 Log watched movie\n(date, rating, review, place)" as UC13
  usecase "UC14 Edit / delete diary entry" as UC14
  usecase "UC15 Browse diary calendar" as UC15
  usecase "UC16 Browse library lists\n(watched / watchlist / liked)" as UC16
  usecase "UC17 Manage collections" as UC17
  ' Reminders and notifications
  usecase "UC18 Set / change release reminder" as UC18
  usecase "UC19 Cancel release reminder" as UC19
  usecase "UC20 Read notifications" as UC20
  usecase "UC22 Sync movie catalog" as UC22
  usecase "UC23 Dispatch due reminders" as UC23
  usecase "UC24 Deliver reminder notification" as UC24
}

actor "Scheduler\n(Spring @Scheduled)" as Scheduler
actor "TMDB API" as TMDB <<external system>>
actor "SMTP server\n(optional)" as SMTP <<external system>>

Visitor <|-[norank]- Member

Visitor -- UC01
Visitor -- UC02

Member -- UC04
Member -- UC03
Member -- UC21
Member -- UC05
Member -- UC06
Member -- UC08
Member -- UC11
Member -- UC12
Member -- UC13
Member -- UC14
Member -- UC15
Member -- UC16
Member -- UC17
Member -- UC20
Member -- UC18
Member -- UC19

UC01 ..> UC02 : <<include>>
UC04 ..> UC02 : <<extend>>\n[profile has no favorite genres]
UC06 <.. UC07 : <<extend>>\n[text query of 2+ chars, first page,\nAPI key set]
UC08 ..> UC10 : <<include>>
UC08 <.. UC09 : <<extend>>\n[details missing or stale,\nAPI key set]
UC18 <.. UC24 : <<extend>>\n[reminder date already reached]
UC23 .[norank].> UC24 : <<include>>

UC19 -[hidden]- UC22
UC19 -[hidden]- UC23
UC01 -[hidden,norank]- UC04
UC04 -[hidden,norank]- UC03
UC03 -[hidden,norank]- UC21

UC07 -- TMDB
UC09 -- TMDB
UC22 -- TMDB
UC22 -- Scheduler
UC23 -- Scheduler
UC24 -- SMTP
@enduml
