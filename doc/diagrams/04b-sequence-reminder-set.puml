@startuml
!include _style.iuml
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 12
skinparam BoxPadding 10
hide footbox
title Sequence Diagram 2 (part 1 of 2) — Set a release reminder

autonumber
actor "Member" as U
participant "ReminderController" as C
participant "ReminderServiceImpl" as S
participant "MovieRepository" as MR
participant "UserRepository" as UR
participant "ReminderRepository" as RR
participant "ReminderDispatchServiceImpl" as D
database "PostgreSQL" as DB
  U -> C ++ : PUT /api/v1/users/me/reminders/{movieId} {offsetDays: 3, channel: EMAIL}
  C -> S ++ : save(userId, movieId, request)
  alt offsetDays not in {0, 1, 3, 7}
    S --> C : BusinessRuleException
    C --> U : 400 ErrorResponse
  else allowed offset
    S -> MR : findById(movieId)
    MR -> DB : SELECT movies
    MR --> S : Optional<Movie>
    alt movie not found
      S --> C : ResourceNotFoundException
      C --> U : 404 ErrorResponse
    else movie already released (or no release date)
      S --> C : BusinessRuleException
      C --> U : 400 ErrorResponse
    else upcoming movie
      S -> RR : findByUserIdAndMovieId(userId, movieId)
      RR -> DB : SELECT reminders
      alt reminder already exists
        S -> S : existing.reschedule(3, EMAIL) → status SCHEDULED
      else new reminder
        S -> UR : getReferenceById(userId)
        S -> RR : save(new Reminder(user, movie, 3, EMAIL))
        RR -> DB : INSERT reminders (SCHEDULED, release − 3 days)
      end
      S -> D : dispatchIfDue(reminder)
      alt reminder date already reached
        D -> D : send(reminder, today) (same steps as part 2, steps 28–41)
        D --> S : true
      else date in the future
        D --> S : false
      end
      S --> C -- : ReminderResponse
      C --> U -- : 200 ReminderResponse
    end
  end
@enduml
